      }
    },
    "지도는 땅 크기로 그리면 됩니다. 땅 위에 펼치고": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The only proper map is drawn on a scale of a mile to the mile, spread directly over the country."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "지도는 땅 크기로 그리면 됩니다. 땅 위에 펼치고"
          }
        }
      }
    },
    "지도는 서랍에 넣어 두었소": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "I have tucked the chart into the drawer."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "지도는 서랍에 넣어 두었소"
          }
        }
      }
    },
    "지도를 펴 놓고 섬 이름을 짓고 있습니다": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Has spread out a chart and is naming every island"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "지도를 펴 놓고 섬 이름을 짓고 있습니다"
          }
        }
      }
    },
    "지도만 들여다봅니다": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Poring over the map once more"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "지도만 들여다봅니다"
          }
        }
      }
    },
    "지도보다 거울이 필요한데요": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "I have far more need of a looking-glass than a map."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "지도보다 거울이 필요한데요"
          }
        }
      }
    },
    "지도부터 그려야 이야기가 됩니다": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "One must draw the chart before the tale can sail."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "지도부터 그려야 이야기가 됩니다"
          }
        }
      }
    },
    "지도에 보물 표시를 하고 펜을 듭니다": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Marks an X for treasure on the map and picks up the pen"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "지도에 보물 표시를 하고 펜을 듭니다"
          }
        }
      }
    },
    "지루함이야말로 유일한 죄악이지요": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Boredom, after all, is the only true sin"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "지루함이야말로 유일한 죄악이지요"
          }
        }
      }
    },
    "지방 독자 모임에서 온 초대장에 정중히 답장을 적고 있습니다": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Penning a courteous reply to an invitation from a provincial reading club"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "지방 독자 모임에서 온 초대장에 정중히 답장을 적고 있습니다"
          }
        }
      }
    },
    "지붕에서 비가 새어": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Rain leaked through the roof—"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "지붕에서 비가 새어"
          }
        }
      }
    },
    "지붕이 새면 로맨스보다 수리비가 먼저 걱정됩니다": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "When a roof leaks, sensible people worry over the glazier's bill before gothic romance."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "지붕이 새면 로맨스보다 수리비가 먼저 걱정됩니다"
          }
        }
      }
    },
    "지진": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Earthquake"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "지진"
          }
        }
      }
    },
    "지쳤습니다. 글자가 \\(Int((1 - Balance.staminaTiredMultiplier) * 100))% 덜 늘고 0이 되면 탈진합니다.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tired — writing slows by \\(Int((1 - Balance.staminaTiredMultiplier) * 100))%, and reaching 0 causes exhaustion."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "지쳤습니다. 글자가 \\(Int((1 - Balance.staminaTiredMultiplier) * 100))% 덜 늘고 0이 되면 탈진합니다."
          }
        }
      }
    },
    "지켜보시오": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Watch and see."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "지켜보시오"
          }
        }
      }
    },
    "지킨다": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Keep it"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "지킨다"
          }
        }
      }
    },
    "지킬 박사도 당신처럼 이중생활을 즐겼소": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Dr. Jekyll, too, was fond of leading a double life."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "지킬 박사도 당신처럼 이중생활을 즐겼소"
          }
        }
      }
    },
    "지팡이 끝으로 자갈길을 톡 치더니 서재 쪽으로 방향을 틉니다": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Taps the gravel path with the tip of the cane and turns back toward the study"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "지팡이 끝으로 자갈길을 톡 치더니 서재 쪽으로 방향을 틉니다"
          }
        }
      }
    },
    "지팡이를 문가에 세워 두고 뜨거운 김을 내뿜으며 펜을 쥡니다": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Stands the walking stick by the door and takes up the pen, still steaming from the brisk walk"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "지팡이를 문가에 세워 두고 뜨거운 김을 내뿜으며 펜을 쥡니다"
          }
        }
      }
    },
    "직전 고시 환율": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Previous published rate"
          }
        }
      }
    },
    "직접 고른 자리는 이레 동안 주인이 안 건드립니다.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The bookseller leaves handpicked counter spots untouched for 7 days."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "직접 고른 자리는 이레 동안 주인이 안 건드립니다."
          }
        }
      }
    },
    "직접 고른 자리라 이레 동안 그대로입니다.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Handpicked spot — stays on the counter for 7 days."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "직접 고른 자리라 이레 동안 그대로입니다."
          }
        }
      }
    },
    "직접 답장한다": {
      "localizations": {
