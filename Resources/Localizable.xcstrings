    "비평가 둘이 {T}(을|를) 두고 지면에서 다툽니다. 다들 궁금해합니다": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Two critics are sparring over {T} in print, piquing everyone's curiosity"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "비평가 둘이 {T}(을|를) 두고 지면에서 다툽니다. 다들 궁금해합니다"
          }
