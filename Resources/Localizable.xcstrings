    },
    "비평가는 원래 남의 글에 흠집 내는 게 직업입니다": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A critic is merely a man whose trade is finding spots upon other men's waistcoats."
