          "stringUnit": {
            "state": "translated",
            "value": "The dawn air has a chill to it. A cup of coffee would not go amiss."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "새벽 공기가 차갑습니다. 커피가 한 잔 생각나는군요"
          }
        }
      }
    },
    "새벽 글은 아침에 읽으면 부끄럽습니다": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "What one writes at dawn always makes one blush at breakfast."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "새벽 글은 아침에 읽으면 부끄럽습니다"
