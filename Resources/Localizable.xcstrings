    },
    "비평가가 '작품 얘기를 나누고 싶다'며 초대장을 보냈습니다": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A critic sent an invitation, hoping to 'discuss the work over supper'"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "비평가가 '작품 얘기를 나누고 싶다'며 초대장을 보냈습니다"
          }
        }
      }
    },
    "비평가가 당신 책을 칭찬했다지요": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "I hear the reviewer praised your latest volume."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "비평가가 당신 책을 칭찬했다지요"
          }
        }
      }
    },
    "비평가가 좋아할 대목을 압니다": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Knows just the passages critics will admire"
