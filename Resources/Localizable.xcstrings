      }
    },
    "빌린 게 아니라 고쳐 쓴 겁니다. 훨씬 낫게": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "I did not borrow it; I rescued it. And improved it vastly."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "빌린 게 아니라 고쳐 쓴 겁니다. 훨씬 낫게"
