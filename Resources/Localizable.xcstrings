        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "월몰 후"
          }
        }
      }
    },
    "월요일에 받은 과제 「\\(deadline.title)」을 \\(deadline.metAt.map { $0.formatted(.dateTime.weekday(.wide)) } ?? ": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Finished Monday's assignment \\\"\\(deadline.title)\\\" on \\(deadline.metAt.map { $0.formatted(.dateTime.weekday(.wide)) } ?? "
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
