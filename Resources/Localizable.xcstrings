    "완벽한 고독 속에서만 들리는 운율이 있습니다": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "There is a cadence that can only be heard in complete solitude"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "완벽한 고독 속에서만 들리는 운율이 있습니다"
