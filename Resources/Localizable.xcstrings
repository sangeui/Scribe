    },
    "원고만 보낸다": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Send pages only"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "원고만 보낸다"
          }
        }
      }
    },
    "원고만 보냈습니다. 누군가 읽었다는데 누군지 모릅니다": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sent only the speech. Someone read it aloud, though nobody knows who"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "원고만 보냈습니다. 누군가 읽었다는데 누군지 모릅니다"
          }
        }
      }
    },
    "원고만 읽어 준다": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Only read their draft"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "원고만 읽어 준다"
          }
        }
