      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The patron’s name was printed in front, and the patron promptly bought ten copies"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "앞장에 후원자 이름이 들어갔습니다. 후원자는 열 권을 샀습니다"
          }
        }
      }
    },
    "앞장이 비었습니다. 작가는 '책이 헌사'라고 합니다": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The front page remains blank. 'The book itself is the dedication,' says the author"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "앞장이 비었습니다. 작가는 '책이 헌사'라고 합니다"
          }
        }
      }
    },
    "앨리스가 토끼 이야기의 뒷부분을 묻습니다": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
