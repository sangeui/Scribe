          }
        }
      }
    },
    "편지함을 한쪽으로 밀어 두고 다시 작품의 세계로 잠깁니다": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Pushes the letter tray aside and submerges back into the story"
