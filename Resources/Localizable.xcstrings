        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "몇 장은 분명 다른 날에 쓴 것이다"
          }
        }
      }
    },
    "몇 장을 잃었다는데 티가 거의 안 난다": {
      "localizations": {
        "en": {
          "stringUnit": {
