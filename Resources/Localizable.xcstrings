            "state": "translated",
            "value": "어둠도 빛이 있어야 보이는 법이오"
          }
        }
      }
    },
    "어둠은 글이 없어도 깊어집니다": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The darkness deepens whether words come or not"
