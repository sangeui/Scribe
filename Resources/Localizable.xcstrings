    "원고지 여백에 작은 캐리커처를 그리고 있습니다": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sketching tiny caricatures in the margins of the manuscript"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "원고지 여백에 작은 캐리커처를 그리고 있습니다"
          }
        }
      }
    },
    "원고지가 구겨집니다": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You are crumpling the foolscap."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "원고지가 구겨집니다"
          }
        }
      }
    },
    "원고지를 넘기던 바람에 마지막 촛불이 흔들리다 꺼졌습니다": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The breeze from turning a page snuffed out the last flickering flame"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "원고지를 넘기던 바람에 마지막 촛불이 흔들리다 꺼졌습니다"
