    },
    "이번 주 돌발 상황 \\(events)번. '\\(author)(이|가) 요즘 산만하다'는 말이 돕니다": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "\\(events) mishaps this week alone. People are whispering that \\(author) has grown terribly distracted."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이번 주 돌발 상황 \\(events)번. '\\(author)(이|가) 요즘 산만하다'는 말이 돕니다"
          }
        }
      }
    },
    "이번 주 마감 · \\(deadline.title)": {
