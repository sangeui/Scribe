          "stringUnit": {
            "state": "translated",
            "value": "Bookshelf"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "서가"
          }
        }
      }
    },
    "서가 책은 \\(Int(Balance.shelfSales * 100))%만 팔립니다. 직접 내린 책은 이레 동안 주인이 다시 올리지 않습니다.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Bookshelf books sell at \\(Int(Balance.shelfSales * 100))% rate. Manually shelved books won't be moved back by the bookseller for 7 days."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "서가 책은 \\(Int(Balance.shelfSales * 100))%만 팔립니다. 직접 내린 책은 이레 동안 주인이 다시 올리지 않습니다."
          }
        }
      }
    },
    "서두": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "prelude"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "서두"
          }
        }
      }
    },
    "서두르지 않되 쉬지도 않고, 별처럼 제 궤도를 돌며 씁니다": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Without haste, yet without rest, I write as a star pursues its orbit."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "서두르지 않되 쉬지도 않고, 별처럼 제 궤도를 돌며 씁니다"
          }
        }
      }
    },
    "서랍 구석에서 성냥개비 하나를 간신히 찾아 불을 밝혔습니다": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
