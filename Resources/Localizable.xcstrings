    "운율은 어둠에서 옵니다": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Meter is born of darkness."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "운율은 어둠에서 옵니다"
          }
        }
      }
    },
    "운율이 너무 가볍소": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your meter is altogether too light."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "운율이 너무 가볍소"
          }
        }
      }
    },
    "운율이 안 맞으면 밤에 잠이 안 옵니다": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "An uneven meter keeps me waking all the night."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "운율이 안 맞으면 밤에 잠이 안 옵니다"
          }
        }
      }
    },
    "운율이 없으면 안 읽소": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "If it does not scan in five feet, I shall not read a word."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "운율이 없으면 안 읽소"
          }
        }
      }
    },
    "운은 필요 없소. 시간이면 되오": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Keep your fortune; give me time instead."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "운은 필요 없소. 시간이면 되오"
          }
        }
      }
    },
