          }
        }
      }
    },
    "창밖 거리에서 악단이 연주를 시작해 구경하러 내려갔습니다": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A street band struck up a tune outside, drawing the author downstairs"
