      }
    },
    "대형 출판사": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Major Publisher"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "대형 출판사"
          }
        }
      }
    },
    "대형·문예·독립 출판사에 한 번씩 원고를 보내세요": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Send manuscripts to Major, Literary, and Indie publishers at least once each"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "대형·문예·독립 출판사에 한 번씩 원고를 보내세요"
