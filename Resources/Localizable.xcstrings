    },
    "원고지 귀퉁이에 토끼 귀를 그려 넣고 빙그레 웃습니다": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Doodling rabbit ears in the corner of the page with a quiet smile"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "원고지 귀퉁이에 토끼 귀를 그려 넣고 빙그레 웃습니다"
          }
        }
      }
    },
    "원고지 더미 옆에서 끝내 눈꺼풀이 내려앉았습니다": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Eyelids finally gave way beside a stack of manuscript pages"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "원고지 더미 옆에서 끝내 눈꺼풀이 내려앉았습니다"
