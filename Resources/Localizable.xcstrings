        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "편집자는 신이 났고 작가는 원고에 옛 제목을 몰래 적어 둡니다"
          }
        }
      }
    },
    "편집자는 어디 있었나": {
