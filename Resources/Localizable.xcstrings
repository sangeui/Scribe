    },
    "회중시계 바늘이 거꾸로 가는 건 아닐까요": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Could the hands of the pocket watch be running backward?"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "회중시계 바늘이 거꾸로 가는 건 아닐까요"
          }
        }
      }
    },
    "회중시계를 꺼내 보더니 '늦었다, 늦었어!'라며 뛰어 돌아옵니다": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Checks a pocket watch, cries 'I’m late, I’m late!' and hurries back"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "회중시계를 꺼내 보더니 '늦었다, 늦었어!'라며 뛰어 돌아옵니다"
          }
        }
      }
    },
    "회중시계를 한 번 확인하고는 빠른 걸음으로 돌아옵니다": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Glances at a pocket watch and strides briskly back"
          }
