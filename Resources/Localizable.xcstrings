        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "책으로 갚는다"
          }
        }
      }
    },
    "책을 덮은 뒤에도 따라온다": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "follows you after the book is closed"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "책을 덮은 뒤에도 따라온다"
          }
        }
      }
    },
    "책을 받은 작가가 밑줄을 긋기 시작했습니다": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Given the book, the author immediately began underlining passages"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "책을 받은 작가가 밑줄을 긋기 시작했습니다"
          }
        }
      }
    },
    "책이 꾸준히 팔리고 독자 주문을 지키고 낭독회·사인회가 잘 끝나면 오르고, 매대 책이 품절되거나 반품이 오거나 주문을 놓치면 내립니다.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Rises with steady sales, fulfilled reader requests, and successful readings or signings; falls with counter stockouts, returns, or missed requests."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "책이 꾸준히 팔리고 독자 주문을 지키고 낭독회·사인회가 잘 끝나면 오르고, 매대 책이 품절되거나 반품이 오거나 주문을 놓치면 내립니다."
          }
        }
      }
    },
    "책장": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Bookshelf"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "책장"
          }
        }
      }
    },
    "처마 끝에 떨어지는 빗방울 소리가 서재를 채웁니다": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The patter of raindrops from the eaves fills the study."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "처마 끝에 떨어지는 빗방울 소리가 서재를 채웁니다"
          }
        }
      }
    },
    "천둥소리가 울릴 때마다 촛불이 크게 흔들립니다": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Every peal of thunder sets the candle flame dancing wildly."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "천둥소리가 울릴 때마다 촛불이 크게 흔들립니다"
          }
        }
      }
    },
    "천장의 나뭇결 무늬만 세면서 깊은 한숨을 내쉽니다": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Counts the wood grain patterns on the ceiling and heaves a deep sigh"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "천장의 나뭇결 무늬만 세면서 깊은 한숨을 내쉽니다"
          }
        }
      }
    },
    "천천히 쓰게. 급하게 쓴 책은 금방 티가 나": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Take your time writing. A rushed book always shows"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "천천히 쓰게. 급하게 쓴 책은 금방 티가 나"
          }
        }
      }
    },
    "철통같은 원고 금고지기": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Ironclad Keeper of the Manuscript Vault"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "철통같은 원고 금고지기"
          }
        }
      }
    },
    "첫 글자를 쓰세요": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Write your very first character"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "첫 글자를 쓰세요"
          }
        }
