    "잔을 받아 들고 일어나 앉습니다. 손이 조금 떨립니다": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Takes the cup and sits up, hands trembling slightly"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "잔을 받아 들고 일어나 앉습니다. 손이 조금 떨립니다"
          }
        }
      }
    },
    "잔을 받지 않습니다. 눈도 안 뜹니다": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Won't take the cup, eyes still shut tight"
