            "state": "translated",
            "value": "첫 장부터 마지막까지 한 호흡이다"
          }
        }
      }
    },
    "첫 장은 늘 어렵습니다": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The first chapter is ever the hardest."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "첫 장은 늘 어렵습니다"
          }
        }
