    "완벽한 서재의 건축가": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Architect of the Perfect Study"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "완벽한 서재의 건축가"
          }
        }
      }
    },
    "왕과 여왕을 체스판 위에 세웠을 뿐입니다": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "I merely arranged the King and Queen upon a proper chessboard."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "왕과 여왕을 체스판 위에 세웠을 뿐입니다"
          }
        }
      }
    },
    "왕관보다 지하실 열쇠가 더 쓸모 있소": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The key to the cellar vault is of far greater use to me than a crown."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "왕관보다 지하실 열쇠가 더 쓸모 있소"
          }
        }
      }
    },
    "왕관의 무게는 잉크로 달아 봐야 아는 법입니다": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Only when weighed in ink does one know the true heft of a crown."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "왕관의 무게는 잉크로 달아 봐야 아는 법입니다"
          }
        }
      }
    },
    "왕립 문학 총서의 편찬자": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Compiler of the Royal Literary Canon"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "왕립 문학 총서의 편찬자"
          }
        }
      }
    },
    "왕비 역을 맡은 소년 배우의 의상이 아직 도착하지 않았답니다": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The boy actor playing the Queen still has not received his gown"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "왕비 역을 맡은 소년 배우의 의상이 아직 도착하지 않았답니다"
          }
        }
      }
    },
    "외다리 선원의 뱃노래 가사를 입속으로 흥얼거리고 있습니다": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Humming a one-legged sailor’s sea shanty under their breath"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "외다리 선원의 뱃노래 가사를 입속으로 흥얼거리고 있습니다"
          }
        }
      }
    },
    "외알 안경": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Monocle"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "외알 안경"
          }
        }
      }
    },
    "외투를 머리끝까지 뒤집어쓰고 미동도 하지 않습니다": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Pulls the overcoat right over their head and refuses to stir"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "외투를 머리끝까지 뒤집어쓰고 미동도 하지 않습니다"
          }
        }
      }
    },
    "요즘 조용하죠.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Things have been quiet lately."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "요즘 조용하죠."
          }
        }
      }
    },
    "요즘 책은 글쎄… 그래도 {T}(은|는) 다시 사 볼 만해": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Books these days, well… still, {T} is worth buying again"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "요즘 책은 글쎄… 그래도 {T}(은|는) 다시 사 볼 만해"
          }
        }
      }
    },
    "요청이 많아 잠시 쉽니다.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Rate limited — pausing briefly."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "요청이 많아 잠시 쉽니다."
          }
        }
      }
    },
    "우리 서점 간판 작가 아닌가. 뭐든 말만 하게": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You're our shop's flagship author! Just say the word"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "우리 서점 간판 작가 아닌가. 뭐든 말만 하게"
          }
        }
      }
    },
    "우리끼리도 방금 \\(title) 이야기를 하던 참이었소. 자리가 비었으니 앉으시오": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "We were just speaking of \\(title) ourselves. There is an empty seat—please, sit"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "우리끼리도 방금 \\(title) 이야기를 하던 참이었소. 자리가 비었으니 앉으시오"
          }
        }
      }
    },
    "우유 접시가 창틀에 놓였습니다": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A saucer of milk now sits on the windowsill"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "우유 접시가 창틀에 놓였습니다"
          }
        }
      }
    },
    "우유를 타지 않은 홍차는 마시지 않겠다고 합니다": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Refuses to drink black tea without a splash of milk"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "우유를 타지 않은 홍차는 마시지 않겠다고 합니다"
          }
        }
      }
    },
    "우유만 준다": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Just give it milk"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "우유만 준다"
          }
        }
      }
    },
    "우체부가 서명을 받으러 왔습니다": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The postman arrived asking for a signature"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "우체부가 서명을 받으러 왔습니다"
          }
        }
      }
    },
    "우체부가 편지 뭉치를 두고 갔습니다. 절반은 독자입니다": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The postman left a thick stack of mail—half of it from readers"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "우체부가 편지 뭉치를 두고 갔습니다. 절반은 독자입니다"
          }
        }
      }
    },
    "우체부가 편지를 잘못 배달했는데 아무도 눈치채지 못했습니다": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The postman misdelivered the morning mail, and nobody even noticed."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "우체부가 편지를 잘못 배달했는데 아무도 눈치채지 못했습니다"
          }
        }
      }
    },
