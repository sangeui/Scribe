    "찬 바람에 정신이 맑아졌다며 가벼운 손놀림으로 이어 씁니다": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Mind cleared by the brisk wind, resumes writing with a light hand"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "찬 바람에 정신이 맑아졌다며 가벼운 손놀림으로 이어 씁니다"
          }
        }
      }
    },
    "찬물로 세수하고 돌아왔습니다": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Splashed cold water on their face and returned"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "찬물로 세수하고 돌아왔습니다"
          }
        }
      }
    },
    "찬장도 서랍도 텅 비었습니다. 비상용 잉크라도 구해 두시지요": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Cupboard and drawer alike are bare. Do procure some reserve ink, at least."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "찬장도 서랍도 텅 비었습니다. 비상용 잉크라도 구해 두시지요"
          }
        }
      }
    },
    "찬장에 따뜻한 차와 커피를 아껴 두고 내어주지 않으면...": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "When warm tea and coffee are hoarded in the cupboard instead of served..."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "찬장에 따뜻한 차와 커피를 아껴 두고 내어주지 않으면..."
          }
        }
      }
    },
    "참견": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Meddler"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "참견"
          }
        }
      }
    },
    "참는다": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Endure it"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "참는다"
          }
        }
      }
    },
    "참았습니다. 작가 눈 밑이 어둡습니다": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Endured the racket. Dark circles have formed beneath the author’s eyes"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "참았습니다. 작가 눈 밑이 어둡습니다"
          }
        }
      }
    },
    "참을성 있는 독자": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "patient readers"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "참을성 있는 독자"
          }
        }
      }
    },
    "찻잎과 원두의 비축가": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Hoarder of Tea Leaves and Coffee Beans"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "찻잎과 원두의 비축가"
          }
        }
      }
    },
    "찻잔 받침을 내려놓는 소리와 함께 다시 문장을 잇습니다": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "With the soft clink of the saucer, the next sentence begins"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "찻잔 받침을 내려놓는 소리와 함께 다시 문장을 잇습니다"
          }
        }
      }
    },
    "찻잔만 물끄러미 보더니 다시 팔을 베고 눕습니다": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Stares blankly at the teacup, then rests their head back on their arm"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "찻잔만 물끄러미 보더니 다시 팔을 베고 눕습니다"
          }
        }
      }
    },
    "찻잔을 내려놓는 타이밍 하나로도 거절의 뜻을 전할 수 있습니다": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The precise moment one sets down a teacup may convey a most decisive refusal."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "찻잔을 내려놓는 타이밍 하나로도 거절의 뜻을 전할 수 있습니다"
          }
        }
      }
    },
    "찻잔을 드는 우아한 각도에 대해 강연할 자리가 생겼답니다": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Found an occasion to lecture on the proper angle at which to hold a teacup"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "찻잔을 드는 우아한 각도에 대해 강연할 자리가 생겼답니다"
          }
        }
      }
    },
    "찻잔의 김에 눈이 뜨였습니다": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The steam rising from the teacup opens drowsy eyes"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "찻잔의 김에 눈이 뜨였습니다"
          }
        }
      }
    },
    "찻잔이 다 식도록 소식이 없습니다": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The teacup has gone cold without a single piece of news"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "찻잔이 다 식도록 소식이 없습니다"
          }
        }
      }
    },
    "찻주전자를 치우고 작은 서탁 앞에 앉아 미소 지으며 펜을 듭니다": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Clears away the teapot, sits at the little writing table, and picks up the pen with a smile"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
