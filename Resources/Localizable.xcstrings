            "value": "The vicar quoted {T} in Sunday's sermon, and parishioners arrived on Monday"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "목사가 설교에서 {T}(을|를) 인용했습니다. 월요일에 교인들이 왔습니다"
          }
        }
      }
    },
    "목사님 부부가 차를 마시러 왔습니다": {
      "localizations": {
        "en": {
