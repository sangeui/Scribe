    },
    "광대 역이 대사를 멋대로 바꿨습니다": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The clown has been improvising his own lines again"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "광대 역이 대사를 멋대로 바꿨습니다"
          }
        }
      }
    },
    "광대의 말장난을 동화로 옮겨 놓았더군": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You have turned my fool's wordplay into a nursery tale."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "광대의 말장난을 동화로 옮겨 놓았더군"
          }
        }
      }
    },
    "광대의 입을 빌려야 진짜 진실을 말할 수 있지요": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "One must borrow the fool's tongue to speak the plainest truth."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "광대의 입을 빌려야 진짜 진실을 말할 수 있지요"
