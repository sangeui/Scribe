    },
    "대비": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Preparedness"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "대비"
          }
        }
      }
    },
    "대사는 소리 내어 읽어 봐야 맛을 아오": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Dialogue must be tasted upon the tongue to judge its seasoning."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "대사는 소리 내어 읽어 봐야 맛을 아오"
          }
        }
      }
    },
    "대표 작가": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Featured Author"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "대표 작가"
          }
        }
      }
    },
    "대학에서 강연을 요청했습니다. 사례는 두둑합니다": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A university has invited the author to lecture, offering a generous fee"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "대학에서 강연을 요청했습니다. 사례는 두둑합니다"
