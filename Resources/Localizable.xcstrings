      }
    },
    "월출 전": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Before Moonrise"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "월출 전"
          }
        }
      }
    },
    "위층에서 망치 소리가 납니다. 며칠 간답니다": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Hammering echoes from upstairs—and will reportedly last for days"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "위층에서 망치 소리가 납니다. 며칠 간답니다"
