            "value": "House Favorite"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "단골 작가"
          }
        }
      }
    },
    "단골 할아버지": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Old Regular"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "단골 할아버지"
          }
        }
      }
    },
    "단골이 \"다음 책은 나한테 먼저\"라며 선금을 두고 갔습니다": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A regular left a deposit saying, \"Save the first copy of the next book for me\""
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "단골이 \"다음 책은 나한테 먼저\"라며 선금을 두고 갔습니다"
          }
        }
      }
    },
    "단골이 {T} 사인본을 부탁했습니다. 서점이 열 권을 더 주문했습니다": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A regular asked for a signed copy of {T}. The bookstore ordered ten more"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "단골이 {T} 사인본을 부탁했습니다. 서점이 열 권을 더 주문했습니다"
          }
        }
      }
    },
    "단어 두 개를 하나로 합치면 뜻도 두 배가 됩니다": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Pack two meanings into one word like a portmanteau, and it does double the work."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "단어 두 개를 하나로 합치면 뜻도 두 배가 됩니다"
          }
        }
      }
    },
    "단편은 한 번에 읽혀야 합니다. 끊기면 마법이 깨집니다": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A tale must be read at a single sitting; break it, and the spell is shattered."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "단편은 한 번에 읽혀야 합니다. 끊기면 마법이 깨집니다"
          }
        }
      }
    },
    "닫겠소. 종이가 날리오": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Then I shall shut it before my pages take flight."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "닫겠소. 종이가 날리오"
          }
        }
      }
    },
    "닫기": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Close"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "닫기"
          }
        }
      }
    },
    "닫으면 잉크가 안 마릅니다": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Keep it shut and the ink will never dry."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "닫으면 잉크가 안 마릅니다"
          }
        }
      }
    },
    "달빛에 눈이 익어 다시 씁니다": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Eyes adjusted to the moonlight, resumes writing"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "달빛에 눈이 익어 다시 씁니다"
          }
        }
      }
    },
    "달성 성과: \\(a.title) (\\(a.detail))": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Unlocked by: \\(a.title) (\\(a.detail))"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "달성 성과: \\(a.title) (\\(a.detail))"
          }
        }
      }
    },
    "달성하기 전까지 정확한 조건은 가려져 있습니다.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Exact conditions remain hidden until unlocked."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "달성하기 전까지 정확한 조건은 가려져 있습니다."
          }
        }
      }
    },
    "담요를 두르고 다시 씁니다": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Draws a blanket around their shoulders and writes on"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "담요를 두르고 다시 씁니다"
          }
        }
      }
    },
    "담요를 머리끝까지 끌어 올리며 깊은 숨만 내쉽니다": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Pulls the blanket over their head with a deep sigh"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "담요를 머리끝까지 끌어 올리며 깊은 숨만 내쉽니다"
          }
        }
      }
    },
    "담요를 무릎에 덮고서도 머릿속은 갑판 위를 달리고 있습니다": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Though a rug covers my knees, my mind is racing across a wind-swept deck."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "담요를 무릎에 덮고서도 머릿속은 갑판 위를 달리고 있습니다"
          }
        }
      }
    },
    "답으로 받은 토큰입니다.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Response output tokens generated by the model."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "답으로 받은 토큰입니다."
          }
        }
      }
    },
    "답을 기다리고 있습니다. 편지가 왔잖습니까": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "They are awaiting an answer. Did you not see the letter?"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "답을 기다리고 있습니다. 편지가 왔잖습니까"
          }
        }
      }
    },
    "답이 없어 원고가 대형 출판사로 갔습니다. 선금이 왔습니다": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "With no reply, the manuscript went to a Major Publisher. An advance has arrived"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "답이 없어 원고가 대형 출판사로 갔습니다. 선금이 왔습니다"
          }
        }
      }
    },
    "답장 쉰 통을 썼습니다. 손목이 아프답니다": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Wrote fifty replies by hand and now complains of a sore wrist"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "답장 쉰 통을 썼습니다. 손목이 아프답니다"
          }
        }
      }
    },
    "답장은 다음에. 작가는 조금 찔리는 눈치입니다": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Replies can wait. The author looks slightly guilty"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "답장은 다음에. 작가는 조금 찔리는 눈치입니다"
          }
        }
      }
    },
    "답장은 반만 쓰고 나머지는 내일로 미뤘습니다": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Wrote half the reply and left the rest for tomorrow"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "답장은 반만 쓰고 나머지는 내일로 미뤘습니다"
          }
        }
      }
    },
    "답장을 써야 합니다": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This correspondence requires a reply."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "답장을 써야 합니다"
          }
        }
      }
    },
    "답장이 늦으면 큰일 난다고 합니다": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Says delaying this reply will cause no end of trouble"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "답장이 늦으면 큰일 난다고 합니다"
          }
        }
      }
    },
    "당나귀 한 마리와 침낭만 있으면 어디든 여행기가 됩니다": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Give me a donkey and a sleeping-sack, and any road becomes a travelogue."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "당나귀 한 마리와 침낭만 있으면 어디든 여행기가 됩니다"
          }
        }
      }
    },
    "당신 같았으면 초상화를 벽 속에 묻어 버렸겠지요": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Had I left it to you, you would have walled the portrait up in the cellar."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "당신 같았으면 초상화를 벽 속에 묻어 버렸겠지요"
          }
        }
      }
    },
    "당신 소설엔 칼싸움 한 번이 없더군": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "There is not a single sword-fight in all your chapters."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "당신 소설엔 칼싸움 한 번이 없더군"
          }
        }
      }
    },
    "당신 작품은 번역하면서 많이 고쳤소": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "I had to mend a great deal when translating your play."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "당신 작품은 번역하면서 많이 고쳤소"
          }
        }
      }
    },
    "당신 한숨 소리보다는 작소": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Not half so loud as your sighing."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "당신 한숨 소리보다는 작소"
          }
        }
      }
    },
    "대독으로 대신했습니다. 청중은 아쉬워했습니다": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Someone else read the address aloud; the audience was disappointed"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "대독으로 대신했습니다. 청중은 아쉬워했습니다"
          }
        }
      }
    },
    "대문호 초상화": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Literary Master Portraits"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "대문호 초상화"
          }
        }
      }
    },
    "대문호들의 든든한 메세나": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Stalwart Maecenas of Literary Masters"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "대문호들의 든든한 메세나"
          }
        }
