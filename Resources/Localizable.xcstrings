        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "비평가는 원래 남의 글에 흠집 내는 게 직업입니다"
          }
        }
      }
    },
    "비평가도 가끔 옳습니다": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Even a critic stumbles upon the truth now and then."
