    "커피 향에 눈을 번쩍 뜹니다. 다시 씁니다": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Eyes snap open at the aroma of coffee. Back to writing"
          }
        },
        "ko": {
