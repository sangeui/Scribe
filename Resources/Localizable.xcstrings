    "혼자 쓰는 것도 나쁘지 않습니다": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Writing in solitude is not half bad"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "혼자 쓰는 것도 나쁘지 않습니다"
          }
        }
      }
    },
    "혼자 읽고 혼자 감탄하기에 아까운 경구가 나왔습니다": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "An epigram has emerged that is far too good to admire all by myself"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "혼자 읽고 혼자 감탄하기에 아까운 경구가 나왔습니다"
          }
        }
      }
    },
    "혼자 잘 쓰고 있었습니다": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "I was getting on famously by myself."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "혼자 잘 쓰고 있었습니다"
          }
        }
      }
    },
    "혼자 체스를 두듯 문장과 문장을 맞물려 놓고 있습니다": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Interlocking sentences like playing a game of chess against oneself"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "혼자 체스를 두듯 문장과 문장을 맞물려 놓고 있습니다"
          }
        }
      }
    },
    "혼자만의 고요 속에서 한 장을 훌쩍 넘겼습니다": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Turned another full page in the hush of solitude"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "혼자만의 고요 속에서 한 장을 훌쩍 넘겼습니다"
          }
