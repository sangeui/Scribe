      }
    },
    "위험": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Critical"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "위험"
          }
        }
      }
    },
    "유난히 바람 잘 날 없는 하루가 있습니다.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Some days in the study never know a moment of peace."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "유난히 바람 잘 날 없는 하루가 있습니다."
          }
        }
      }
    },
    "유령은 1막에 나와야 극이 사는 법이오": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A ghost must walk in the first act if the play is to live."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "유령은 1막에 나와야 극이 사는 법이오"
          }
        }
      }
    },
    "유리 등피 안으로 따뜻한 불빛이 번지며 원고지가 환해집니다": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Warm light spreads inside the glass chimney, brightening the manuscript"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "유리 등피 안으로 따뜻한 불빛이 번지며 원고지가 환해집니다"
          }
        }
      }
    },
    "유리 등피에 그을음이 꼈다며 닦기 전엔 안 켠답니다": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Refuses to light the lamp until the soot is wiped from the glass chimney"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "유리 등피에 그을음이 꼈다며 닦기 전엔 안 켠답니다"
          }
        }
      }
    },
    "유머": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "humor"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "유머"
          }
        }
      }
    },
    "유명인의 구매": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Notable Patron"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "유명인의 구매"
          }
        }
      }
    },
    "유혹을 이기는 유일한 방법은 유혹에 굴복하는 것입니다": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The only way to get rid of a temptation is to yield to it."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "유혹을 이기는 유일한 방법은 유혹에 굴복하는 것입니다"
          }
        }
      }
    },
    "으로": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "with"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "으로"
          }
        }
      }
    },
    "은": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Silver"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "은"
          }
        }
      }
    },
    "은행나무 잎을 따러 갔습니다": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Stepped out to gather ginkgo leaves"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "은행나무 잎을 따러 갔습니다"
          }
        }
      }
    },
    "음냐…": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Mmmph…"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "음냐…"
          }
        }
      }
    },
    "음악에 취해 눈을 감고 박자만 맞추고 있습니다": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Closes their eyes, lost in the music, merely tapping out the beat"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "음악에 취해 눈을 감고 박자만 맞추고 있습니다"
          }
        }
      }
    },
    "응접실 문을 닫고 씁니다": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "I write with the drawing-room door firmly shut."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "응접실 문을 닫고 씁니다"
          }
        }
      }
    },
    "응접실 문이 삐걱거리는 소리에 원고를 덮어 두고 차를 내갔습니다": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "At the creak of the parlor door, slipped the manuscript out of sight and served tea"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "응접실 문이 삐걱거리는 소리에 원고를 덮어 두고 차를 내갔습니다"
          }
        }
      }
    },
    "응접실에 아무도 없으니 원고를 숨기지 않고 마음껏 씁니다": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "With the parlor empty, there is no need to hide the manuscript—I write freely"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "응접실에 아무도 없으니 원고를 숨기지 않고 마음껏 씁니다"
          }
        }
      }
    },
    "응접실에는 어울리겠군요": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "It will make a pleasant enough ornament for the parlor."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "응접실에는 어울리겠군요"
          }
        }
      }
    },
    "응접실에서 무슨 소설이 나오겠소": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "What sort of novel can possibly come out of a drawing-room?"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "응접실에서 무슨 소설이 나오겠소"
          }
        }
      }
    },
    "응접실에서 손님을 맞고 있습니다": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Receiving callers in the parlor"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "응접실에서 손님을 맞고 있습니다"
          }
        }
      }
    },
    "응접실의 정중한 인사 한마디가 칼보다 날카롭습니다": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A polite civility in a drawing-room cuts deeper than any rapier."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "응접실의 정중한 인사 한마디가 칼보다 날카롭습니다"
          }
        }
      }
    },
    "응접실이 조용합니다": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The parlor is remarkably quiet"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "응접실이 조용합니다"
          }
        }
      }
    },
    "의사가 하루 한 시간은 걸으라고 했습니다": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The doctor ordered at least an hour’s walk each day"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "의사가 하루 한 시간은 걸으라고 했습니다"
          }
        }
      }
    },
    "의자가 이렇게 편했던가요": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Was this chair always so comfortable?"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "의자가 이렇게 편했던가요"
          }
        }
      }
    },
    "의자가 좀 삐걱거리오": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Mind the chair; it has a slight creak."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "의자가 좀 삐걱거리오"
          }
        }
      }
    },
    "이 곡은 지금 쓰는 장의 분위기와 안 맞는다고 합니다": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Claims this tune does not suit the mood of the current chapter"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 곡은 지금 쓰는 장의 분위기와 안 맞는다고 합니다"
          }
        }
      }
    },
    "이 깃펜은 어제 다 썼다고 합니다": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Claims all the magic in this quill was used up yesterday"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 깃펜은 어제 다 썼다고 합니다"
          }
        }
      }
    },
    "이 농담만 마저 하겠다고 합니다": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Insists on delivering the punchline first"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 농담만 마저 하겠다고 합니다"
          }
        }
      }
    },
    "이 문장이 잘 안 풀립니다": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This sentence refuses to untangle itself."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 문장이 잘 안 풀립니다"
          }
        }
      }
    },
    "이 잉크는 색이 마음에 안 든다며 돌려보냅니다": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sends the ink back, displeased with its shade"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 잉크는 색이 마음에 안 든다며 돌려보냅니다"
          }
        }
      }
    },
    "이 작가를 처음 읽는 이": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "those new to this author"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 작가를 처음 읽는 이"
          }
        }
      }
    },
    "이 작가의 최고다": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "is the author's finest work"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 작가의 최고다"
          }
        }
      }
    },
    "이 장을 통째로 지울까 고민 중입니다": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Debating whether to scrap the entire chapter"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 장을 통째로 지울까 고민 중입니다"
          }
        }
      }
    },
    "이 집은 어딘가 기울어 있습니다": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This house leans imperceptibly toward ruin."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 집은 어딘가 기울어 있습니다"
          }
        }
      }
    },
    "이 책상은 둘이 쓰기엔 좁소": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This desk is too narrow for the pair of us."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 책상은 둘이 쓰기엔 좁소"
          }
        }
      }
    },
    "이 책을 진열창에 겁니다. \\(Int((Balance.windowSales - 1) * 100))% 더 팔리고, 직접 고른 자리라 이레 동안 주인이 안 건드립니다.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Place this book in the window display for +\\(Int((Balance.windowSales - 1) * 100))% sales. The bookseller won't touch handpicked spots for 7 days."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 책을 진열창에 겁니다. \\(Int((Balance.windowSales - 1) * 100))% 더 팔리고, 직접 고른 자리라 이레 동안 주인이 안 건드립니다."
          }
        }
      }
    },
    "이 책을 추천할 방법을 찾지 못했다": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "I have found no honest way to recommend this book"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 책을 추천할 방법을 찾지 못했다"
          }
        }
      }
    },
    "이 책이 \\(Int(Balance.adBoost))배로 팔리는 중입니다.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This book is currently selling at \\(Int(Balance.adBoost))× speed."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 책이 \\(Int(Balance.adBoost))배로 팔리는 중입니다."
          }
        }
      }
    },
    "이 초는 냄새가 싫다고 합니다": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Complains about the scent of this candle"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 초는 냄새가 싫다고 합니다"
          }
        }
      }
    },
    "이 침묵의 운율을 깨뜨리지 말라며 손가락을 입술에 댑니다": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Presses a finger to their lips, begging not to shatter the meter of this silence"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 침묵의 운율을 깨뜨리지 말라며 손가락을 입술에 댑니다"
          }
        }
      }
    },
    "이 편지는 좀 깁니다": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This letter is rather a long one."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 편지는 좀 깁니다"
          }
        }
      }
    },
    "이 표본만 정리하고 오겠답니다": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Promises to return as soon as this specimen is cataloged"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 표본만 정리하고 오겠답니다"
          }
        }
      }
    },
    "이 한 장만 마저 쓰겠다고 합니다": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Insists on finishing just this one page of the letter"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 한 장만 마저 쓰겠다고 합니다"
          }
        }
      }
    },
    "이겼습니다. {B}(은|는) \"운이 좋았군\"이라고 합니다": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Victory! {B} mutters, \"Beginner's luck\""
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이겼습니다. {B}(은|는) \"운이 좋았군\"이라고 합니다"
          }
        }
      }
    },
    "이달의 책": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Book of the Month"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이달의 책"
          }
        }
      }
    },
    "이러면 한 줄도 못 씁니다": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "I cannot write a single line under this siege."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이러면 한 줄도 못 씁니다"
          }
        }
      }
    },
    "이런 책은 십 년에 하나 나온다": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A book like this comes along once in a decade"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이런 책은 십 년에 하나 나온다"
          }
        }
      }
    },
    "이루면 다음 단계가 나옵니다.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Complete this to reveal the next tier."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이루면 다음 단계가 나옵니다."
          }
        }
      }
    },
    "이름난 비평가가 저녁 모임에 초대했습니다": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A renowned critic has invited the author to an evening gathering"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이름난 비평가가 저녁 모임에 초대했습니다"
          }
        }
      }
    },
    "이미 너무 멀리 왔다고 합니다": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Claims to have walked too far to turn around right away"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이미 너무 멀리 왔다고 합니다"
          }
        }
      }
    },
    "이번 무도회의 파트너 명단까지는 꼭 듣고 가야 한답니다": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Insists on hearing the full list of dance partners for the upcoming ball first"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이번 무도회의 파트너 명단까지는 꼭 듣고 가야 한답니다"
          }
        }
      }
    },
    "이번 장에서 또 누가 죽어야 합니다": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Someone else must die in this chapter."
