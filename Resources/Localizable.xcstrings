          "stringUnit": {
            "state": "translated",
            "value": "펜촉을 깨끗이 씻어 끼우니 다시 글씨가 또렷이 나옵니다"
          }
        }
      }
    },
    "펜촉을 담그고 만족스럽게 고개를 끄덕입니다": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Dips the nib and nods with satisfaction"
