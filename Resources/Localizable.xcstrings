    "세금 징수원이 다녀갔습니다. 주인이 작가 물건을 하나 팔아 메웠습니다": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The tax collector paid a visit; the keeper sold one of the author's items to cover the bill"
          }
