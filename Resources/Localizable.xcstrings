        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "편집자가 제목이 밋밋하다며 바꾸자고 합니다"
          }
        }
      }
    },
    "편집자는 다 그렇소": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Every editor since Gutenberg has had a brisk temper."
