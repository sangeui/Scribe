    },
    "차 모임에 초대받았습니다": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Was invited to a curious little tea party"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "차 모임에 초대받았습니다"
          }
        }
      }
    },
    "차 모임에 초대해도 될까요": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "May I invite you to a mad tea-party?"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "차 모임에 초대해도 될까요"
          }
        }
      }
    },
    "차 모임은 여섯 시입니다. 늘": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tea-time is at six o'clock. Forever six."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "차 모임은 여섯 시입니다. 늘"
          }
        }
      }
    },
    "차 한 잔 남겨 두었어요": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "I have left a fresh cup of tea for you."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "차 한 잔 남겨 두었어요"
          }
        }
      }
    },
    "차 한 잔만 더 하고 가겠다고 합니다": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Says they will be right back after just one more cup of tea"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "차 한 잔만 더 하고 가겠다고 합니다"
          }
        }
      }
    },
    "차 한 잔의 온도보다 문장의 리듬이 더 중요합니다": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The cadence of a period matters infinitely more than the temperature of one's tea."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "차 한 잔의 온도보다 문장의 리듬이 더 중요합니다"
          }
        }
      }
    },
    "차가 식은 줄도 몰랐다며 돌아왔습니다": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Came back saying they had not even noticed the tea go cold"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "차가 식은 줄도 몰랐다며 돌아왔습니다"
          }
        }
      }
    },
    "차가 아직 남았다고 합니다": {
      "localizations": {
