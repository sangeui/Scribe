    "야경꾼과 나누던 이야기만 마저 끝내고 오겠다고 합니다": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Says they will return right after finishing a chat with the night watchman"
          }
