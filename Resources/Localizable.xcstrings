        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "아이템 \\(Balance.deadlineItems)개와 판매 +\\(Int((Balance.deadlineSalesBoost - 1) * 100))%(하루)를 받았습니다. 다음 과제는 월요일에 옵니다. 이 줄은 하루 뒤 사라집니다."
          }
        }
      }
    },
