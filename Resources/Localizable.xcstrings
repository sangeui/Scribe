    },
    "이번 주 매대 맨 앞은 \\(book.displayTitle). \\(author)(이|가) 지나가다 두 번 봤다고 합니다": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Front and center on the table this week is \\(book.displayTitle). They say \\(author) strolled past twice to admire it."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이번 주 매대 맨 앞은 \\(book.displayTitle). \\(author)(이|가) 지나가다 두 번 봤다고 합니다"
          }
        }
      }
    },
    "이번 주 안에 탈고": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Finish this week"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이번 주 안에 탈고"
          }
        }
      }
    },
    "이번 주는 비 소식뿐입니다": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "There is no news this week save the rain."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이번 주는 비 소식뿐입니다"
          }
        }
      }
    },
    "이번 주는 손님이 끊이지 않았습니다. 앞자리를 더 내드리지요": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Customers poured in all week. I'll clear more space up front for your books"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이번 주는 손님이 끊이지 않았습니다. 앞자리를 더 내드리지요"
          }
        }
      }
    },
    "이불을 두르고 쓰다가 그만 눈이 감겼습니다": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Wrapped in a blanket while writing, eyes simply drifted shut"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이불을 두르고 쓰다가 그만 눈이 감겼습니다"
          }
        }
      }
    },
    "이사는 하루가 걸렸고 원고는 두 번 셌습니다": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Moving took a full day, and the author counted the manuscript pages twice"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이사는 하루가 걸렸고 원고는 두 번 셌습니다"
          }
        }
      }
    },
    "이사한다": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Move out"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이사한다"
          }
        }
      }
    },
    "이성적인 추리와 광기는 같은 방의 양쪽 창문입니다": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Ratiocination and madness are but opposite windows of the very same chamber."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이성적인 추리와 광기는 같은 방의 양쪽 창문입니다"
          }
        }
      }
    },
    "이십 마일을 걸었다며 자리에 앉습니다": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sits down announcing they just walked twenty miles"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이십 마일을 걸었다며 자리에 앉습니다"
          }
        }
      }
    },
    "이야기가 막 재미있어졌답니다": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Says the conversation has just turned most interesting"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이야기가 막 재미있어졌답니다"
          }
        }
      }
    },
    "이야기가 제일 재미있는 데라고 합니다": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Says the story has just reached the best part"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이야기가 제일 재미있는 데라고 합니다"
          }
        }
      }
    },
    "이야기를 하다 새 장면이 떠올랐습니다": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Hit upon a brand-new scene in the middle of telling the tale"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이야기를 하다 새 장면이 떠올랐습니다"
          }
        }
      }
    },
    "이웃 도시 문학제에서 초청장이 왔습니다. 사흘 일정입니다": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "An invitation arrived from a neighboring city’s literary festival for a three-day visit"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이웃 도시 문학제에서 초청장이 왔습니다. 사흘 일정입니다"
          }
        }
      }
    },
    "이웃 부인이 소식을 들고 왔습니다": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A neighboring lady has called with fresh news"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이웃 부인이 소식을 들고 왔습니다"
          }
        }
      }
    },
    "이웃 영지에 연 수입 사천 파운드짜리 독신남이 이사 왔다는 소식입니다": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Word has arrived of a single man of four thousand a year moving into the neighborhood"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이웃 영지에 연 수입 사천 파운드짜리 독신남이 이사 왔다는 소식입니다"
          }
        }
      }
    },
    "이웃에게 잉크를 빌려 왔습니다": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Borrowed some ink from a neighbor"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이웃에게 잉크를 빌려 왔습니다"
          }
        }
      }
    },
    "이웃이 또 혼담을 가져왔습니다": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The neighbors have arrived with fresh news of an engagement."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이웃이 또 혼담을 가져왔습니다"
          }
        }
      }
    },
    "이웃이 미안하다며 저녁에만 치기로 했습니다": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The neighbor apologized and agreed to play only in the evening"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이웃이 미안하다며 저녁에만 치기로 했습니다"
          }
        }
      }
    },
    "이웃이 올 때가 됐는데요": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "It is high time a neighbor called"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이웃이 올 때가 됐는데요"
          }
        }
      }
    },
    "이전 환율 유지": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Keeping previous rate"
          }
        }
      }
    },
    "이제 막 시작했습니다": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "I have only just begun."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이제 막 시작했습니다"
          }
        }
      }
    },
    "이제 울릴 차례군": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Then it is time I made them weep."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이제 울릴 차례군"
          }
        }
      }
    },
    "이제 조용히 찻잔 소리를 들을 수 있겠군요": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "At last, one may hear the gentle clink of a teacup in peace."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이제 조용히 찻잔 소리를 들을 수 있겠군요"
          }
        }
      }
    },
    "이탈리아 기행문은 잘 읽었소. 나도 당나귀를 타고 걸었지": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "I enjoyed your Italian Journey. I, too, once tramped the hills with a donkey."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이탈리아 기행문은 잘 읽었소. 나도 당나귀를 타고 걸었지"
          }
        }
      }
    },
    "이탈리아가 그립습니다": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "My thoughts wander back toward Italy, where the lemon trees bloom."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이탈리아가 그립습니다"
          }
        }
      }
    },
    "이틀 만에 썼다는 게 믿기지 않는다": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "It is hard to believe this was written in a mere two days"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이틀 만에 썼다는 게 믿기지 않는다"
          }
        }
      }
    },
    "익명의 독자": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "An Anonymous Reader"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "익명의 독자"
          }
        }
      }
    },
    "익명의 편지가 '그 장면은 어디서 본 것'이라고 합니다": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "An anonymous letter arrived alleging, 'That scene has been seen before'"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "익명의 편지가 '그 장면은 어디서 본 것'이라고 합니다"
          }
        }
      }
    },
    "익명의 후원인": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Anonymous Patron"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "익명의 후원인"
          }
        }
      }
    },
    "익숙한 선율이 흐르자 막혔던 대화 장면이 단숨에 풀립니다": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "As the familiar melody plays, the stalled dialogue flows all at once"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "익숙한 선율이 흐르자 막혔던 대화 장면이 단숨에 풀립니다"
          }
        }
      }
    },
    "인간은 노력하는 한 방황하기 마련입니다": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Man errs so long as he doth strive."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "인간은 노력하는 한 방황하기 마련입니다"
          }
        }
      }
    },
