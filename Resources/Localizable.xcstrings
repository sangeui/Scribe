    "마루 밑에서 규칙적인 박동 소리가 들리는 듯해 귀를 기울입니다": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Listens intently, convinced a steady heartbeat is throbbing beneath the floorboards"
