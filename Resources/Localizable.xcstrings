          }
        }
      }
    },
    "창밖만 봐도 되는 걸까요": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Is it alright to just gaze out the window?"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "창밖만 봐도 되는 걸까요"
          }
        }
      }
    },
    "창밖에 뭐가 있어서요": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Something outside the window caught my eye."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "창밖에 뭐가 있어서요"
          }
        }
      }
    },
    "창밖으로 눈이 소복이 쌓이고 있습니다. 세상이 조용하군요": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Snow is piling softly outside the window. How hushed the world has grown."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "창밖으로 눈이 소복이 쌓이고 있습니다. 세상이 조용하군요"
          }
        }
      }
    },
    "창밖을 보다 문득 실마리를 잡았습니다": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Caught a sudden thread of an idea while gazing out the window"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "창밖을 보다 문득 실마리를 잡았습니다"
