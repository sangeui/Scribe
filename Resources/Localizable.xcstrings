    "흉상 위의 검은 눈동자에서 시선을 뗄 수 없습니다": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "I cannot tear my gaze from those obsidian eyes upon the bust of Pallas."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "흉상 위의 검은 눈동자에서 시선을 뗄 수 없습니다"
          }
        }
      }
    },
    "흐린 날의 차분한 그늘이 원고지 위에 내려앉습니다": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The calm shade of an overcast sky settles upon the manuscript."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "흐린 날의 차분한 그늘이 원고지 위에 내려앉습니다"
          }
        }
      }
    },
