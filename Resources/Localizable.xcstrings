          "stringUnit": {
            "state": "translated",
            "value": "비평가도 가끔 옳습니다"
          }
        }
      }
    },
    "비평가들이 논란을 벌인다면 그 책은 이미 성공한 셈입니다": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "When the critics disagree, the artist is in accord with himself."
