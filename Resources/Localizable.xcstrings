      }
    },
    "책상이 타면 당신 탓이오": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "If the desk catches fire, I shall blame you."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "책상이 타면 당신 탓이오"
