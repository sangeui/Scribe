    "우편이 멈춰 주문한 책이 못 갑니다": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "With the post halted, mail-order books cannot go out"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "우편이 멈춰 주문한 책이 못 갑니다"
          }
        }
      }
    },
    "우표 붙일 자리만 찾으면 끝난다며 고개를 들지 않습니다": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Does not look up, claiming they only need to find a stamp"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "우표 붙일 자리만 찾으면 끝난다며 고개를 들지 않습니다"
          }
        }
      }
    },
    "우표를 붙이고 자리에 앉았습니다": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Pressed on a stamp and settled back into the chair"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "우표를 붙이고 자리에 앉았습니다"
          }
        }
      }
