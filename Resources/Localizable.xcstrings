        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "법원 서기 시절에 본 얼굴들이 아직도 원고지 위로 걸어 나옵니다"
          }
        }
      }
    },
    "베르가모트 향이 감돌자 무겁던 눈꺼풀이 가벼워집니다": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "As the aroma of bergamot wafts up, heavy eyelids grow light"
