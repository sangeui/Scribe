    },
    "옷깃의 초록 카네이션 향기를 풍기며 우아하게 의자에 앉습니다": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sinks gracefully into the chair, trailing the scent of a green carnation"
          }
        },
        "ko": {
          "stringUnit": {
