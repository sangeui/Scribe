    },
    "구름의 모양을 분류해 기상 일지에 적어 넣어야 한다고 나갔습니다": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Stepped out to classify cloud formations for the meteorological journal"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "구름의 모양을 분류해 기상 일지에 적어 넣어야 한다고 나갔습니다"
          }
        }
      }
    },
    "구름의 모양이 바뀌는 것을 관찰하고 있습니다": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Observing the shifting forms of the clouds outside"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "구름의 모양이 바뀌는 것을 관찰하고 있습니다"
          }
        }
      }
    },
    "구름이 걷히기 전에 프리즘 실험을 마쳐야 한다며 손사래를 칩니다": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Waves a hand, insisting the prism experiment must finish before the clouds part"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "구름이 걷히기 전에 프리즘 실험을 마쳐야 한다며 손사래를 칩니다"
          }
        }
      }
    },
    "구름이 낮게 깔려 낮인데도 등잔을 가까이 두었습니다": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The clouds hang so low I have drawn the lamp close even at midday."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "구름이 낮게 깔려 낮인데도 등잔을 가까이 두었습니다"
          }
        }
      }
    },
    "구상을 하느라 눈을 감고 있었을 뿐입니다": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "My eyes were shut solely for the purpose of composition."
          }
        },
        "ko": {
