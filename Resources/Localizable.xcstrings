        }
      }
    },
    "등장인물 이름을 짓는 데만 반나절을 썼습니다": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "I have spent half the day merely christening a character."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "등장인물 이름을 짓는 데만 반나절을 썼습니다"
          }
