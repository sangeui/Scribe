    },
    "첫 줄에서 한 시간째 멈춰 있습니다": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "I have been stranded upon the opening line for an hour."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "첫 줄에서 한 시간째 멈춰 있습니다"
