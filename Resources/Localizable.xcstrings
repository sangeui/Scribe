    "우편 파업": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Postal Disruption"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "우편 파업"
          }
