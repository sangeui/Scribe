    },
    "편지 배달부가 오늘따라 늦는군요": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The post is unusually late today"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "편지 배달부가 오늘따라 늦는군요"
