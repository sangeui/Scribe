        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "편지함을 한쪽으로 밀어 두고 다시 작품의 세계로 잠깁니다"
          }
        }
      }
    },
    "편집자가 '이 제목으로는 안 팔린다'고 못을 박습니다": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The editor insists flatly, 'It will never sell under this title'"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "편집자가 '이 제목으로는 안 팔린다'고 못을 박습니다"
          }
        }
      }
    },
    "편집자가 성미가 급하오. 조심하시오": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The editor has a brisk temper. Best beware."
