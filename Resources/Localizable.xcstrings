          "stringUnit": {
            "state": "translated",
            "value": "Scarf"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "목도리"
          }
        }
      }
    },
    "목사가 설교에서 {T}(을|를) 인용했습니다. 월요일에 교인들이 왔습니다": {
      "localizations": {
        "en": {
          "stringUnit": {
