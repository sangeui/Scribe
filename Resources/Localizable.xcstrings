        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "편집자가 요즘 유행하는 제목으로 바꾸자고 편지를 보냈습니다"
          }
        }
      }
    },
    "편집자가 제목이 밋밋하다며 바꾸자고 합니다": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
