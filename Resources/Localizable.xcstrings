    "원고부터": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Manuscript first"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "원고부터"
          }
