      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Says not a word can be written until the raven departs"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "까마귀가 날아가기 전까지는 안 된답니다"
