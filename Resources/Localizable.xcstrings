            "state": "translated",
            "value": "첫 성과를 달성하면 칭호가 열립니다"
          }
        }
      }
    },
    "첫 원고의 마중물": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sponsor of the First Manuscript"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "첫 원고의 마중물"
          }
        }
      }
    },
    "첫 월요일 아침에 주인이 지난주 셈을 보냅니다.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The bookseller sends last week's statement on Monday mornings."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "첫 월요일 아침에 주인이 지난주 셈을 보냅니다."
          }
        }
      }
    },
    "첫 장": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "opening chapter"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "첫 장"
          }
        }
      }
    },
    "첫 장부터 마지막까지 한 호흡이다": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
