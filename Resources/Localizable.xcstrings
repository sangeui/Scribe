          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "품절 · 재판 \\(Format.integer(reprint.copies))부 \\(max(1, Int((reprint.due.timeIntervalSince(now) / 3600).rounded(.up))))시간 뒤"
          }
        }
      }
    },
    "품절로 돌려보낸 손님이 많았습니다. 재판을 미리 청했으면 더 팔았을 겁니다": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "We turned away many customers due to stockouts. Earlier reprints would have sold more"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "품절로 돌려보낸 손님이 많았습니다. 재판을 미리 청했으면 더 팔았을 겁니다"
          }
        }
