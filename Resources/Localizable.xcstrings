    },
    "광물 상자를 정리하다 왔습니다": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "I have just come from ordering my cabinet of minerals."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "광물 상자를 정리하다 왔습니다"
