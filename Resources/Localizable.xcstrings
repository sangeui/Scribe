    },
    "쓰는 중인 작가가 별 2개 이하 비평을 받게 하세요": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Have the active author receive a review of 2 stars or fewer"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "쓰는 중인 작가가 별 2개 이하 비평을 받게 하세요"
          }
        }
      }
    },
    "쓰려던 단어가 혀끝에서 맴돕니다": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The exact word is right on the tip of the tongue"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "쓰려던 단어가 혀끝에서 맴돕니다"
          }
        }
      }
    },
    "쓰면 줄고 쉬면 돌아옵니다.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Drains while writing and recovers while resting."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "쓰면 줄고 쉬면 돌아옵니다."
          }
        }
      }
    },
    "쓴맛에 미간을 찌푸리더니 곧장 다음 줄을 써 내려갑니다": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Frowns slightly at the bitterness, then plunges straight into the next line"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "쓴맛에 미간을 찌푸리더니 곧장 다음 줄을 써 내려갑니다"
          }
        }
      }
    },
    "쓸 거리가 없어 펜을 돌립니다": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Twirling the pen for lack of anything to write"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "쓸 거리가 없어 펜을 돌립니다"
          }
        }
      }
    },
    "쓸 걸 주셔야 쓰지요": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You must give me something to write before I can write it."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "쓸 걸 주셔야 쓰지요"
          }
        }
      }
    },
    "아, 네. 쓰고 있었습니다": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Ah—yes, of course. I was writing."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "아, 네. 쓰고 있었습니다"
          }
        }
      }
    },
    "아래층에서 뭔가 깨지는 소리가 났습니다": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Something shattered downstairs"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "아래층에서 뭔가 깨지는 소리가 났습니다"
          }
        }
      }
    },
    "아름다움의 가장 높은 경지는 늘 슬픔과 맞닿아 있지요": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The highest manifestation of beauty is forever allied to melancholy."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "아름다움의 가장 높은 경지는 늘 슬픔과 맞닿아 있지요"
          }
        }
      }
    },
    "아무 말도 안 했습니다. 작가는 속이 끓습니다": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Said nothing at all, though the author is seething inside"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "아무 말도 안 했습니다. 작가는 속이 끓습니다"
          }
        }
      }
    },
    "아무 일도 안 하는 것은 세상에서 가장 어려운 일입니다": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Doing nothing at all is the most difficult thing in the world"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "아무 일도 안 하는 것은 세상에서 가장 어려운 일입니다"
          }
        }
      }
    },
    "아무 일도 일어나지 않는 장은 재미가 없는데요": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A chapter in which nothing happens is dreadfully dull"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "아무 일도 일어나지 않는 장은 재미가 없는데요"
          }
        }
