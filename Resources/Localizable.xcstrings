        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "야경꾼과 나누던 이야기만 마저 끝내고 오겠다고 합니다"
          }
        }
      }
    },
    "약강 오보격의 박자가 한 음절 모자라는군요": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "My iambic pentameter wants for a single syllable."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "약강 오보격의 박자가 한 음절 모자라는군요"
          }
        }
      }
    },
    "어기면 거절 확률이 2일 동안 10%p 오릅니다.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Miss it and item refusal chance rises by +10%p for 2 days."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "어기면 거절 확률이 2일 동안 10%p 오릅니다."
          }
        }
      }
    },
    "어기면 거절 확률이 \\(Balance.deadlinePenaltyHours / 24)일 동안 \\(Int(Balance.deadlinePenalty * 100))%p 오릅니다.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Miss it and item refusal chance rises by +\\(Int(Balance.deadlinePenalty * 100))%p for \\(Balance.deadlinePenaltyHours / 24)d."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "어기면 거절 확률이 \\(Balance.deadlinePenaltyHours / 24)일 동안 \\(Int(Balance.deadlinePenalty * 100))%p 오릅니다."
          }
        }
      }
    },
    "어깨가 돌처럼 굳었습니다. 조금 지치는군요": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "My shoulders have turned to stone. I am growing rather weary."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "어깨가 돌처럼 굳었습니다. 조금 지치는군요"
          }
        }
      }
    },
    "어느 독자가 {T} 서평을 신문에 다시 올렸습니다": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A reader republished a glowing review of {T} in the paper"
