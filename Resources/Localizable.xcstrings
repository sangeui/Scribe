          }
        }
      }
    },
    "매대 \\(count)/\\(slots)": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Counter \\(count)/\\(slots)"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "매대 \\(count)/\\(slots)"
          }
        }
      }
    },
    "매대 \\(counterSlots)칸 · ": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Counter \\(counterSlots) slots · "
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "매대 \\(counterSlots)칸 · "
          }
        }
      }
    },
    "매대 \\(progress.trustLevel.counterSlots)칸 가운데 한 칸에 둡니다. 칸이 다 차 있으면 주인이 고른 책 중 가장 덜 팔리는 것을 내립니다.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Place on one of the \\(progress.trustLevel.counterSlots) counter slots. If full, replaces the slowest-selling book picked by the bookseller."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "매대 \\(progress.trustLevel.counterSlots)칸 가운데 한 칸에 둡니다. 칸이 다 차 있으면 주인이 고른 책 중 가장 덜 팔리는 것을 내립니다."
          }
        }
      }
    },
    "매대 앞자리": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Front Table"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "매대 앞자리"
          }
        }
      }
    },
    "매대 책은 제값에 팔립니다. 칸 수는 주인의 신뢰에 달렸습니다(\\(slots)칸). 비면 주인이 잘 팔릴 책으로 채우고, 아침마다 다시 정리합니다.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Counter books sell at full rate. Slot count depends on bookseller trust (\\(slots) slots). The bookseller fills empty slots and rearranges non-handpicked books each morning."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "매대 책은 제값에 팔립니다. 칸 수는 주인의 신뢰에 달렸습니다(\\(slots)칸). 비면 주인이 잘 팔릴 책으로 채우고, 아침마다 다시 정리합니다."
          }
